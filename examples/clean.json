{
  "campaign_id": "renewal-reminder",
  "name": "Renewal reminder",
  "data_fields": ["first_name", "renewal_date"],
  "segments": ["active_members", "recent_signups"],
  "audience": {"segment": "active_members"},
  "schedule": {
    "start": "2026-12-01T08:00:00-07:00",
    "end": "2026-12-31T17:00:00-07:00",
    "contact_window": {
      "start": "08:00",
      "end": "21:00",
      "timezone": "recipient"
    }
  },
  "flow": {
    "start": "welcome",
    "steps": [
      {
        "id": "welcome",
        "type": "sms",
        "message": "Hi {{first_name}}, your renewal date is {{renewal_date}}. Reply STOP to opt out.",
        "next": "follow_up"
      },
      {
        "id": "follow_up",
        "type": "call",
        "next": null
      }
    ]
  }
}
